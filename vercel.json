{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run install:all",
  "buildCommand": "node scripts/build-vercel.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/allHoldings", "destination": "/api/index" },
    { "source": "/allPositions", "destination": "/api/index" },
    { "source": "/allPositons", "destination": "/api/index" },
    { "source": "/allOrders", "destination": "/api/index" },
    { "source": "/newOrder", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/:path*", "destination": "/dashboard/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
